; Engine configuration file.
; Edit project settings through the Godot editor when possible.
config_version=5

[application]

config/name="The Long Way Home"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.05, 0.08, 1)

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194321)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194323)]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
zoom_out={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81), Object(InputEventKey,"physical_keycode":45)]
}
zoom_in={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventKey,"physical_keycode":61)]
}
