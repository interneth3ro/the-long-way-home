[gd_resource type="Resource" script_class="DialogueConversation" format=3 uid="uid://cg3ljtt586ye2"]

[ext_resource type="Script" uid="uid://cltwhconv0001" path="res://dialogue/dialogue_conversation.gd" id="1_conversation"]
[ext_resource type="Script" uid="uid://cltwhentry001" path="res://dialogue/dialogue_entry.gd" id="2_entry"]

[sub_resource type="Resource" id="Resource_dave_question"]
script = ExtResource("2_entry")
entry_id = &"computer_opening.dave_question"
speaker_id = &"dave"
speaker_display_name = "Dave"
text = "Computer? Can you hear me?"

[sub_resource type="Resource" id="Resource_computer_status"]
script = ExtResource("2_entry")
entry_id = &"computer_opening.computer_status"
speaker_id = &"computer"
speaker_display_name = "Computer"
text = "Primary systems offline. Emergency functions operating at minimal capacity."

[sub_resource type="Resource" id="Resource_dave_response"]
script = ExtResource("2_entry")
entry_id = &"computer_opening.dave_response"
speaker_id = &"dave"
speaker_display_name = "Dave"
text = "Then we'd better figure out how to get you running again."

[resource]
script = ExtResource("1_conversation")
conversation_id = &"computer_opening"
entries = Array[ExtResource("2_entry")]([SubResource("Resource_dave_question"), SubResource("Resource_computer_status"), SubResource("Resource_dave_response")])
