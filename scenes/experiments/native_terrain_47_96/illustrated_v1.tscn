text = "ILLUSTRATED TERRAIN V1 - 10 illustrated / 84 MAGENTA-MARKED DIAGNOSTIC"

[node name="Instructions" type="Label" parent="."]
offset_left = 32.0
offset_top = 52.0
text = "Select PaintingWorkspace > TileMap > Terrains > Connect. Paint Earth or Green.\n128-unit cells; zoom out in the editor. Start with broad filled regions and long straight boundaries.\nMagenta center squares mean UNSUPPORTED ARTWORK, not finished illustration.\nCorners, narrow links, isolated patches and boundary endpoints may select diagnostic tiles.\nNo F5/F6 needed. Record both vertical directions, endpoints and brush order."

