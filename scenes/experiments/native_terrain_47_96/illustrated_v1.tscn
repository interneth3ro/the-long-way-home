[node name="Limitations" type="Label" parent="."]
offset_left = 32.0
offset_top = 4320.0
text = "128px laboratory scale is not production gameplay scale. Edge materials and native Connect selection await owner acceptance.\nAll 94 original signatures remain available. Original 16px diagnostic laboratory is unchanged.\nNo production renderer integration or performance acceptance."
