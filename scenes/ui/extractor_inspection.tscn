thickness = 1
vertical = true

[sub_resource type="StyleBoxLine" id="HorizontalDivider"]
color = Color(0.52, 0.40, 0.27, 0.5)
thickness = 1

[node name="ExtractorInspection" type="VBoxContainer"]
mouse_filter = 2
theme_override_constants/separation = 16
