[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/ui/inventory_ui.gd" id="1_inventory"]
[ext_resource type="Theme" path="res://assets/ui/b1_theme.tres" id="2_b1"]

[node name="InventoryUI" type="CanvasLayer"]
layer = 2
script = ExtResource("1_inventory")

[node name="HUD" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("2_b1")

[node name="Toggle" type="Button" parent="HUD"]
mouse_filter = 0
offset_left = 24.0
offset_top = 56.0
offset_right = 220.0
offset_bottom = 90.0
focus_mode = 0
text = "Inventory (Tab)"

[node name="Panel" type="PanelContainer" parent="HUD"]
visible = false
offset_left = 24.0
offset_top = 100.0
offset_right = 400.0
mouse_filter = 0

[node name="Content" type="VBoxContainer" parent="HUD/Panel"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 6

[node name="Title" type="Label" parent="HUD/Panel/Content"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"B1Title"
text = "Inventory"

[node name="MaterialsTitle" type="Label" parent="HUD/Panel/Content"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"B1MutedLabel"
text = "Materials"

[node name="Materials" type="GridContainer" parent="HUD/Panel/Content"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/h_separation = 6
theme_override_constants/v_separation = 6
columns = 5

[node name="Divider" type="HSeparator" parent="HUD/Panel/Content"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"B1InventoryDivider"

[node name="EquipmentTitle" type="Label" parent="HUD/Panel/Content"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"B1MutedLabel"
text = "Machines / Equipment"

[node name="Equipment" type="GridContainer" parent="HUD/Panel/Content"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/h_separation = 6
theme_override_constants/v_separation = 6
columns = 5

[node name="Overflow" type="ScrollContainer" parent="HUD/Panel/Content"]
visible = false
custom_minimum_size = Vector2(0, 64)
layout_mode = 2
mouse_filter = 0
horizontal_scroll_mode = 0

[node name="Items" type="VBoxContainer" parent="HUD/Panel/Content/Overflow"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 4

[node name="Hint" type="Label" parent="HUD/Panel/Content"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"B1MutedLabel"
text = "Hover totals · Left-click deploy · Right-click assign · Tab / Esc close"
autowrap_mode = 3

[connection signal="pressed" from="HUD/Toggle" to="." method="_toggle"]
