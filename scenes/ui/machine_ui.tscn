[node name="Status" type="Label" parent="HUD/Panel/Content"]
layout_mode = 2
mouse_filter = 2
text = "Inactive"

[node name="Progress" type="ProgressBar" parent="HUD/Panel/Content"]
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
mouse_filter = 2
