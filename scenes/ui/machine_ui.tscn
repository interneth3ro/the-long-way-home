border_width_bottom = 1
border_color = Color(0.47, 0.61, 0.60, 1)
content_margin_left = 16.0
content_margin_top = 12.0
content_margin_right = 16.0
content_margin_bottom = 12.0

[node name="MachineUI" type="CanvasLayer"]
layer = 2
script = ExtResource("1_ui")

[node name="HUD" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="HUD"]
visible = false
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -360.0
offset_top = 100.0
offset_right = -24.0
grow_horizontal = 0
mouse_filter = 0
