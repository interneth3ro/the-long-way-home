[node name="Content" type="VBoxContainer" parent="HUD/Panel"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="HUD/Panel/Content"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 22
