[node name="Close" type="Button" parent="HUD/Panel/Content"]
layout_mode = 2
mouse_filter = 0
focus_mode = 0
text = "Close (Esc)"

[connection signal="pressed" from="HUD/Panel/Content/Collect" to="." method="_collect"]
[connection signal="pressed" from="HUD/Panel/Content/Close" to="." method="close"]
