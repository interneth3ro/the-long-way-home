[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/ui/machine_ui.gd" id="1_ui"]

[sub_resource type="StyleBoxFlat" id="MachineStyle"]
bg_color = Color(0.045, 0.075, 0.10, 0.97)
border_width_left = 1
border_width_top = 1
