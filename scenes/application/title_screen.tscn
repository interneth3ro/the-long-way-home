[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://scenes/application/title_screen.gd" id="1_title"]
[ext_resource type="PackedScene" path="res://scenes/application/title_background.tscn" id="2_background"]
[ext_resource type="FontFile" path="res://assets/fonts/ibm-plex-sans/IBMPlexSans-Regular.ttf" id="3_font"]
[ext_resource type="FontFile" path="res://assets/fonts/ibm-plex-sans/IBMPlexSans-Medium.ttf" id="4_title_font"]

[sub_resource type="StyleBoxEmpty" id="Empty"]

[sub_resource type="StyleBoxFlat" id="Focus"]
bg_color = Color(0, 0, 0, 0)
border_width_bottom = 1
border_color = Color(0.72, 0.82, 0.85, 0.75)

[sub_resource type="Theme" id="MenuTheme"]
default_font = ExtResource("3_font")
default_font_size = 24
Button/colors/font_color = Color(0.76, 0.81, 0.83, 1)
Button/colors/font_hover_color = Color(0.94, 0.97, 0.98, 1)
Button/colors/font_focus_color = Color(0.94, 0.97, 0.98, 1)
Button/colors/font_pressed_color = Color(1, 1, 1, 1)
Button/colors/font_disabled_color = Color(0.43, 0.49, 0.52, 1)
Button/styles/normal = SubResource("Empty")
Button/styles/hover = SubResource("Empty")
Button/styles/pressed = SubResource("Empty")
Button/styles/disabled = SubResource("Empty")
Button/styles/focus = SubResource("Focus")

[node name="TitleScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("MenuTheme")
script = ExtResource("1_title")

[node name="Background" parent="." instance=ExtResource("2_background")]
layout_mode = 1

[node name="Title" type="Label" parent="."]
layout_mode = 1
anchor_top = 0.11
anchor_right = 1.0
anchor_bottom = 0.22
mouse_filter = 2
theme_override_colors/font_color = Color(0.9, 0.93, 0.94, 1)
theme_override_fonts/font = ExtResource("4_title_font")
theme_override_font_sizes/font_size = 46
text = "THE LONG WAY HOME"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Menu" type="VBoxContainer" parent="."]
layout_mode = 1
anchor_left = 0.5
anchor_top = 0.38
anchor_right = 0.5
anchor_bottom = 0.38
offset_left = -110.0
offset_right = 110.0
offset_bottom = 228.0
grow_horizontal = 2
theme_override_constants/separation = 12

[node name="NewGame" type="Button" parent="Menu"]
custom_minimum_size = Vector2(220, 48)
layout_mode = 2
focus_neighbor_top = NodePath("../Exit")
focus_neighbor_bottom = NodePath("../Exit")
focus_next = NodePath("../Exit")
focus_previous = NodePath("../Exit")
text = "New Game"

[node name="LoadGame" type="Button" parent="Menu"]
custom_minimum_size = Vector2(220, 48)
layout_mode = 2
focus_mode = 0
disabled = true
text = "Load Game"

[node name="Settings" type="Button" parent="Menu"]
custom_minimum_size = Vector2(220, 48)
layout_mode = 2
focus_mode = 0
disabled = true
text = "Settings"

[node name="Exit" type="Button" parent="Menu"]
custom_minimum_size = Vector2(220, 48)
layout_mode = 2
focus_neighbor_top = NodePath("../NewGame")
focus_neighbor_bottom = NodePath("../NewGame")
focus_next = NodePath("../NewGame")
focus_previous = NodePath("../NewGame")
text = "Exit"

[connection signal="pressed" from="Menu/NewGame" to="." method="_on_new_game_pressed"]
[connection signal="pressed" from="Menu/Exit" to="." method="_on_exit_pressed"]
